{
	admin off
	auto_https off
	persist_config off
	log {
		output file {$FD_DESK_DATA_DIR}/service/logs/lan.json {
			roll_size 2MiB
			roll_keep 1
			roll_keep_for 72h
		}
		format filter {
			wrap json
			fields {
				request delete
			}
		}
		level WARN
	}
}

