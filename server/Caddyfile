	reverse_proxy 127.0.0.1:8765 {
		lb_try_duration 10s
	}
	handle_errors 502 503 504 {
		header Content-Type application/json
		respond `{"code":"backend_unavailable","message":"后端暂时无法连接，请稍后重试"}` {err.status_code}
	}
}
